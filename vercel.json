{
  "framework": "nextjs",
  "regions": [
    "icn1"
  ],
  "buildCommand": "npm run build",
  "ignoreCommand": "git diff HEAD~1 --name-only | grep -qE '^(src/|public/|package\\.json|next\\.config|vercel\\.json|tailwind\\.config|tsconfig)' && exit 1 || exit 0",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/**": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/billing",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/breakout",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/trend?step=data",
      "schedule": "5 22 * * *"
    },
    {
      "path": "/api/cron/trend?step=brief",
      "schedule": "5 23 * * *"
    }
  ]
}
